 "definitions": {
  "ytdRevenue": {
   "key": "ytdRevenue",
   "term": "YTD revenue",
   "text": "Invoiced revenue for January to August 2026, AED thousands, each product line counted once in its home vertical."
  },
  "ytdBudget": {
   "key": "ytdBudget",
   "term": "YTD budget",
   "text": "The approved 2026 budget phased by month and summed for the same 8 months."
  },
  "variance": {
   "key": "variance",
   "term": "Variance",
   "text": "Actual less budget for the same period, AED thousands. Negative is below budget and is shown in red."
  },
  "gmPct": {
   "key": "gmPct",
   "term": "GM percent",
   "text": "Gross margin divided by revenue for the same period."
  },
  "openOrders": {
   "key": "openOrders",
   "term": "Open orders",
   "text": "Confirmed customer orders on the system that are not yet invoiced. Not revenue."
  },
  "expectedOrders": {
   "key": "expectedOrders",
   "term": "Expected orders",
   "text": "Opportunities the engineer rates above 90 percent probability, plus letters of intent. Not secured business and not revenue."
  },
  "fyForecast": {
   "key": "fyForecast",
   "term": "FY forecast",
   "text": "YTD actual revenue plus the engineer forecasts for September 2026 and October to December 2026."
  },
  "fyBudget": {
   "key": "fyBudget",
   "term": "FY budget",
   "text": "The approved 2026 revenue budget for the full year."
  },
  "nearMonth": {
   "key": "nearMonth",
   "term": "Near-month forecast",
   "text": "The engineer forecast for September 2026, the first open month."
  },
  "restOfYear": {
   "key": "restOfYear",
   "term": "Rest-of-year forecast",
   "text": "The engineer forecast for October to December 2026."
  },
  "priorYear": {
   "key": "priorYear",
   "term": "Prior year",
   "text": "Full-year 2025 actual revenue and gross margin."
  },
  "yoy": {
   "key": "yoy",
   "term": "Year on year",
   "text": "FY 2026 forecast against FY 2025 actual, percent."
  },
  "plColumns": {
   "key": "plColumns",
   "term": "P&L columns",
   "text": "YTD is January to August 2026 actual. FY forecast is the full year, with costs annualised from the elapsed months. FY budget is the approved full-year budget. No phased profit budget exists for the elapsed months, so profit is compared full year to full year only."
  },
  "buProfitability": {
   "key": "buProfitability",
   "term": "BU profitability",
   "text": "Gross margin less salary, warehouse cost, warehouse salaries and common admin. The rung a vertical head controls."
  },
  "buNetProfit": {
   "key": "buNetProfit",
   "term": "BU-level net profit",
   "text": "BU profitability less provisions, inter-company interest and corporate overhead."
  },
  "roiYtd": {
   "key": "roiYtd",
   "term": "ROI year to date",
   "text": "YTD gross margin divided by the engineer's cost to employ for the same 8 months. A multiple, not a percentage."
  },
  "roiBudget": {
   "key": "roiBudget",
   "term": "Budget ROI",
   "text": "FY budget gross margin divided by annual cost to employ."
  },
  "roiForecast": {
   "key": "roiForecast",
   "term": "Forecast ROI",
   "text": "FY forecast gross margin divided by annual cost to employ."
  },
  "roiPriorYear": {
   "key": "roiPriorYear",
   "term": "Prior-year ROI",
   "text": "FY 2025 gross margin divided by FY 2025 cost to employ."
  },
  "directContribution": {
   "key": "directContribution",
   "term": "Direct contribution",
   "text": "YTD gross margin less YTD cost to employ. Not a profit and loss: warehouse, admin, provisions and group charges are booked at the vertical, not the person."
  },
  "totalOutstanding": {
   "key": "totalOutstanding",
   "term": "Total outstanding",
   "text": "All unpaid invoices at August 2026 month end, whatever their age."
  },
  "netToCollect": {
   "key": "netToCollect",
   "term": "Net to collect",
   "text": "Total outstanding less the provision. The balance the business still expects to collect. It is not a cash forecast and carries no date."
  },
  "provisionReceivable": {
   "key": "provisionReceivable",
   "term": "Provision (receivables)",
   "text": "Half of balances aged 1 to 2 years, all of balances aged over 2 years, and a quarter of a disputed balance aged 91 to 365 days."
  },
  "agingBuckets": {
   "key": "agingBuckets",
   "term": "Aging buckets",
   "text": "Days since the invoice date, whatever the payment terms. A balance can sit in 31 to 90 days and still be within terms."
  },
  "pastDue": {
   "key": "pastDue",
   "term": "Past due",
   "text": "Invoices older than the customer’s payment terms, from invoice date plus terms. This is the contractual measure of lateness."
  },
  "notYetDue": {
   "key": "notYetDue",
   "term": "Not yet due",
   "text": "Invoices inside the customer’s payment terms."
  },
  "agedOverOneYear": {
   "key": "agedOverOneYear",
   "term": "Aged over one year",
   "text": "Invoices older than 365 days."
  },
  "dispute": {
   "key": "dispute",
   "term": "Dispute",
   "text": "The engineer has flagged the balance as disputed by the customer."
  },
  "reasons": {
   "key": "reasons",
   "term": "Reasons for non-collection",
   "text": "Each customer balance carries one reason: internal group companies; follow-up, no timeline or no response; disputes and not yet due. The third is shown split into disputed balances and balances with nothing past due. Reasons partition total outstanding."
  },
  "monthOnMonth": {
   "key": "monthOnMonth",
   "term": "Month on month",
   "text": "Net to collect at August 2026 month end against July 2026 month end."
  },
  "unbilled": {
   "key": "unbilled",
   "term": "Unbilled",
   "text": "Work delivered and not yet invoiced, by project. The three-month trend shows two months ago, last month and this month."
  },
  "unbilledAging": {
   "key": "unbilledAging",
   "term": "Unbilled aging",
   "text": "Days since delivery, in the eight bands used by the reference pack."
  },
  "bridge": {
   "key": "bridge",
   "term": "Month bridge",
   "text": "Previous month, plus projects new this month, less projects cleared by invoicing, plus or less changes on ongoing projects, equals current month."
  },
  "inventoryBands": {
   "key": "inventoryBands",
   "term": "Inventory age bands",
   "text": "Stock value at cost by age since receipt: under 1 year, 1 to 2, 2 to 3, over 3 years. The bands sum to total stock."
  },
  "inventoryProvision": {
   "key": "inventoryProvision",
   "term": "Provision (inventory)",
   "text": "Half of stock aged 2 to 3 years plus all stock over 3 years."
  },
  "mappedLpo": {
   "key": "mappedLpo",
   "term": "Mapped to purchase orders",
   "text": "Stock already allocated to a customer order. Free stock is total stock less this."
  },
  "freeStockOverOneYear": {
   "key": "freeStockOverOneYear",
   "term": "Free stock over one year",
   "text": "Unallocated stock older than a year: the part of inventory most at risk."
  },
  "nonMoving": {
   "key": "nonMoving",
   "term": "Non-moving or obsolete",
   "text": "Stock with no movement in the year, or superseded. A subset of the over-3-year band."
  },
  "inTransit": {
   "key": "inTransit",
   "term": "In transit",
   "text": "Goods paid for or committed and not yet received, with the expected arrival date. Not included in stock."
  },
  "target": {
   "key": "target",
   "term": "Target",
   "text": "The full-year 2026 target for the product line, equal to its approved budget."
  },
  "aspiration": {
   "key": "aspiration",
   "term": "Aspiration",
   "text": "The stretch figure agreed with the vertical head."
  },
  "budgetToDate": {
   "key": "budgetToDate",
   "term": "Budget to date",
   "text": "The target phased by month and summed for January to August 2026. Achieved is compared with this, not with the full-year target."
  },
  "attributedTotal": {
   "key": "attributedTotal",
   "term": "Attributed total",
   "text": "This vertical’s own engineers only. This is the figure every summary table carries."
  },
  "sheetTotal": {
   "key": "sheetTotal",
   "term": "Sheet total",
   "text": "Every row on this sheet, including product lines sold by other verticals’ engineers. Adding sheet totals across verticals would double count them."
  },
  "revenueShare": {
   "key": "revenueShare",
   "term": "Revenue share",
   "text": "Share of netted division forecast revenue, allocated to one decimal so the rows sum to exactly 100.0."
  },
  "workingCapital": {
   "key": "workingCapital",
   "term": "Working capital tied up",
   "text": "Net receivables plus unbilled plus stock at cost. Goods in transit are shown beside it and not added."
  },
  "production": {
   "key": "production",
   "term": "Production",
   "text": "Factory output by month: quantity delivered, its invoiced value, and the material and labour cost booked. Value ties to the vertical’s monthly revenue."
  }
